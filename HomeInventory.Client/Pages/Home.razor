@page "/"
@inject HttpClient Http

<PageTitle>Home inventory</PageTitle>
<h1>Home inventory</h1>
<p class="lead">A private, local record of what you own and where it lives.</p>
@if (dashboard is null) { <p>Loading your inventory…</p> }
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card p-3"><div class="text-muted">Active assets</div><strong class="display-6">@dashboard.AssetCount</strong></div></div>
        <div class="col-md-4"><div class="card p-3"><div class="text-muted">Fixtures</div><strong class="display-6">@dashboard.FixtureCount</strong></div></div>
        <div class="col-md-4"><a class="card p-3 text-decoration-none @(dashboard.MaintenanceOverdue > 0 ? "border-danger" : "")" href="maintenance"><div class="text-muted">Maintenance</div><strong class="display-6">@dashboard.MaintenanceOverdue overdue</strong><div class="small text-muted">@dashboard.MaintenanceDueSoon due in the next 30 days</div></a></div>
        <div class="col-md-4"><a class="card p-3 text-decoration-none @(dashboard.WarrantiesExpiring > 0 ? "border-warning" : "")" href="documents"><div class="text-muted">Warranties</div><strong class="display-6">@dashboard.WarrantiesExpiring expiring</strong><div class="small text-muted">within the next 90 days</div></a></div>
        <div class="col-md-4"><a class="card p-3 text-decoration-none" href="rooms"><div class="text-muted">Rooms documented</div><strong class="display-6">@dashboard.RoomCompletionPercent%</strong><div class="small text-muted">@dashboard.RoomsComplete of @dashboard.RoomCount rooms complete</div></a></div>
        <div class="col-md-4"><a class="card p-3 text-decoration-none" href="documents"><div class="text-muted">Receipts</div><strong class="display-6">@dashboard.AssetsMissingReceipts missing</strong><div class="small text-muted">active assets without a receipt or invoice</div></a></div>
        @foreach (var total in dashboard.Totals)
        {
            <div class="col-md-4"><div class="card p-3"><div class="text-muted">Current insured value (@total.Currency)</div><strong class="display-6"><CurrencyDisplay Value="total.TotalValue" CurrencyCode="@total.Currency" /></strong></div></div>
        }
    </div>
    @if (dashboard.RecentPurchases is { Count: > 0 } recent)
    {
        <h2>Recent purchases</h2>
        <ul class="list-group mb-4">
            @foreach (var purchase in recent)
            {
                <li class="list-group-item d-flex justify-content-between"><span><strong>@purchase.Name</strong> <span class="text-muted">@purchase.Category · @purchase.PurchaseDate.ToString("yyyy-MM-dd")</span></span><CurrencyDisplay Value="purchase.PurchasePrice" CurrencyCode="@purchase.Currency" /></li>
            }
        </ul>
    }
    <h2>Value by category</h2>
    @if (dashboard.Totals.Count == 0) { <p>No assets yet. <a href="assets">Add your first asset</a>.</p> }
    @foreach (var total in dashboard.Totals)
    {
        @if (dashboard.Totals.Count > 1) { <h3 class="h5 mt-3">@total.Currency</h3> }
        <table class="table"><thead><tr><th>Category</th><th class="text-end">Value</th></tr></thead><tbody>@foreach (var category in total.Categories) { <tr><td>@category.Category</td><td class="text-end"><CurrencyDisplay Value="category.Total" CurrencyCode="@total.Currency" /></td></tr> }</tbody></table>
    }
}
<h2 class="mt-5">Find anything</h2>
<div class="input-group"><input class="form-control" @bind="query" @bind:event="oninput" placeholder="Search assets, fixtures, storage, paints, surfaces or documents…" /><button class="btn btn-primary" @onclick="Search">Search</button></div>
@if (results is not null) { <ul class="list-group mt-3">@foreach (var item in results) { <li class="list-group-item"><strong>@item.Title</strong> <span class="text-muted">@item.Kind · @item.Detail @item.LocationPath</span></li> }</ul> }
@code { DashboardDto? dashboard; string query = ""; List<SearchResultDto>? results; protected override async Task OnInitializedAsync() => dashboard = await Http.GetFromJsonAsync<DashboardDto>("api/dashboard"); async Task Search() => results = string.IsNullOrWhiteSpace(query) ? [] : await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/search?q={Uri.EscapeDataString(query)}"); }
