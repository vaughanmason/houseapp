    IEnumerable<RoomDto> RoomsForProperty(Guid? propertyId) => rooms.Where(x => propertyId is null || (x.FloorId is Guid floorId && floors.Any(f => f.Id == floorId && f.PropertyId == propertyId.GetValueOrDefault())));

