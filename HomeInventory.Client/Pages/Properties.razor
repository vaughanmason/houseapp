@page "/properties"
@inject HttpClient Http
@using System.Globalization

<PageTitle>Properties</PageTitle>

<div class="mb-4">
    <h1>Properties</h1>
    <p class="lead">Manage your properties and property-level information.</p>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h2 class="h4">@(editingPropertyId is null ? "Add property" : "Edit property")</h2>
            <input class="form-control mb-2" @bind="propertyName" placeholder="Property name" />
            <input class="form-control mb-2" @bind="propertyAddress" placeholder="Address (optional)" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="propertyPurchaseDate" placeholder="YYYY-MM-DD" /></div>
                <div class="col-md-6"><input class="form-control" @bind="propertyPurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
            </div>
            <input class="form-control mb-2" @bind="propertyFloorArea" type="number" step="0.01" placeholder="Floor area" />
            <select class="form-select mb-2" @bind="propertyCurrency">
                <option value="ZAR">ZAR</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="CAD">CAD</option>
                <option value="AUD">AUD</option>
                <option value="JPY">JPY</option>
            </select>
            <textarea class="form-control mb-2" @bind="propertyNotes" placeholder="Notes"></textarea>
            <button class="btn btn-primary" @onclick="SaveProperty">@(editingPropertyId is null ? "Add property" : "Update property")</button>
            @if (editingPropertyId is not null)
            {
                <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="h4">Your properties</h2>
        @if (properties.Count == 0)
        {
            <div class="alert alert-info">No properties yet. Add your first one to the left.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in properties)
                {
                    <li class="list-group-item">
                        <strong>@p.Name</strong>
                        <div class="text-muted">@p.Address</div>
                        <div class="small text-muted">
                            Purchased: @FormatDate(p.PurchaseDate) · 
                            Price: <CurrencyDisplay Value="p.PurchasePrice" CurrencyCode="p.Currency" /> · 
                            Floor area: @FormatNumber(p.FloorArea) · 
                            Currency: @p.Currency
                        </div>
                        <div class="small mb-2">@p.Notes</div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(p)">Edit</button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-12">
        <div class="card card-body">
            <h2 class="h4">Property photos</h2>
            <select class="form-select mb-2" @bind="photoPropertyId" @bind:after="LoadPhotos">
                <option value="">Choose property</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            @if (!string.IsNullOrEmpty(photoPropertyId))
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-6"><input class="form-control" @bind="photoStorageKey" placeholder="Storage key" /></div>
                    <div class="col-md-6"><input class="form-control" @bind="photoCaption" placeholder="Caption" /></div>
                </div>
                <input class="form-control mb-2" @bind="photoSortOrder" type="number" placeholder="Sort order" />
                <button class="btn btn-outline-primary mb-3" @onclick="AddPhoto">Add photo</button>
                @if (photos.Count > 0)
                {
                    <ul class="list-group">
                        @foreach (var photo in photos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>@photo.Caption</strong> <span class="text-muted">@photo.StorageKey</span></span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePhoto(photo.Id)">Delete</button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-info">No photos yet.</div>
                }
            }
        </div>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    List<PropertyDto> properties = [];
    List<PhotoMetadataDto> photos = [];

    string propertyName = "", propertyAddress = "", propertyPurchaseDate = "", propertyPurchasePrice = "", propertyFloorArea = "", propertyCurrency = "USD", propertyNotes = "";
    string photoPropertyId = "", photoStorageKey = "", photoCaption = "", photoSortOrder = "0";

    Guid? editingPropertyId;
    string? error;

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        properties = await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties") ?? [];
        photos = [];
    }

    void StartEdit(PropertyDto property)
    {
        editingPropertyId = property.Id;
        propertyName = property.Name;
        propertyAddress = property.Address ?? "";
        propertyPurchaseDate = property.PurchaseDate?.ToString("yyyy-MM-dd") ?? "";
        propertyPurchasePrice = property.PurchasePrice?.ToString() ?? "";
        propertyFloorArea = property.FloorArea?.ToString() ?? "";
        propertyCurrency = property.Currency ?? "USD";
        propertyNotes = property.Notes ?? "";
    }

    void CancelEdit()
    {
        editingPropertyId = null;
        ClearForm();
    }

    void ClearForm()
    {
        propertyName = propertyAddress = propertyPurchaseDate = propertyPurchasePrice = propertyFloorArea = propertyNotes = "";
        propertyCurrency = "USD";
    }

    async Task SaveProperty()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(propertyName)) { error = "Property name is required."; return; }

        HttpResponseMessage response;
        if (editingPropertyId is null)
        {
            response = await Http.PostAsJsonAsync("api/properties", new PropertyInput(propertyName, propertyAddress, TryDate(propertyPurchaseDate), TryDecimal(propertyPurchasePrice), TryDecimal(propertyFloorArea), propertyNotes, propertyCurrency));
        }
        else
        {
            response = await Http.PutAsJsonAsync($"api/properties/{editingPropertyId}", new PropertyInput(propertyName, propertyAddress, TryDate(propertyPurchaseDate), TryDecimal(propertyPurchasePrice), TryDecimal(propertyFloorArea), propertyNotes, propertyCurrency));
        }

        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        editingPropertyId = null;
        ClearForm();
        await Load();
    }

    async Task LoadPhotos()
    {
        photos = [];
        if (!Guid.TryParse(photoPropertyId, out var propertyId)) return;
        photos = await Http.GetFromJsonAsync<List<PhotoMetadataDto>>($"api/properties/{propertyId}/photos") ?? [];
    }

    async Task AddPhoto()
    {
        error = null;
        if (!Guid.TryParse(photoPropertyId, out var propertyId)) { error = "Choose a property first."; return; }
        if (string.IsNullOrWhiteSpace(photoStorageKey)) { error = "Provide a storage key for the photo."; return; }
        var response = await Http.PostAsJsonAsync($"api/properties/{propertyId}/photos", new PhotoMetadataInput(photoStorageKey, photoCaption, TryInt(photoSortOrder) ?? 0));
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        photoStorageKey = photoCaption = "";
        photoSortOrder = "0";
        await LoadPhotos();
    }

    async Task DeletePhoto(Guid photoId)
    {
        error = null;
        if (!Guid.TryParse(photoPropertyId, out var propertyId)) { error = "Choose a property first."; return; }
        var response = await Http.DeleteAsync($"api/properties/{propertyId}/photos/{photoId}");
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        await LoadPhotos();
    }

    static string FormatDate(DateOnly? date) => date?.ToString("yyyy-MM-dd") ?? "-";
    static string FormatNumber(decimal? number) => number?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    static DateOnly? TryDate(string? value) => DateOnly.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var result) ? result : null;
    static decimal? TryDecimal(string? value) => decimal.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var result) ? result : null;
    static int? TryInt(string? value) => int.TryParse(value, out var result) ? result : null;
}
