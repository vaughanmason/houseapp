@page "/properties"
@inject HttpClient Http
@using System.Globalization

<PageTitle>Properties</PageTitle>

<div class="mb-4">
    <h1>Properties</h1>
    <p class="lead">Manage your properties and property-level information.</p>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h2 class="h4">@(editingPropertyId is null ? "Add property" : "Edit property")</h2>
            <input class="form-control mb-2" @bind="propertyName" placeholder="Property name" />
            <input class="form-control mb-2" @bind="propertyAddress" placeholder="Address (optional)" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" type="date" @bind="propertyPurchaseDate" title="Purchase date" aria-label="Purchase date" /></div>
                <div class="col-md-6"><input class="form-control" @bind="propertyPurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
            </div>
            <input class="form-control mb-2" @bind="propertyFloorArea" type="number" step="0.01" placeholder="Floor area" />
            <select class="form-select mb-2" @bind="propertyCurrency">
                <option value="ZAR">ZAR</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="CAD">CAD</option>
                <option value="AUD">AUD</option>
                <option value="JPY">JPY</option>
            </select>
            <textarea class="form-control mb-2" @bind="propertyNotes" placeholder="Notes"></textarea>
            <button class="btn btn-primary" @onclick="SaveProperty">@(editingPropertyId is null ? "Add property" : "Update property")</button>
            @if (editingPropertyId is not null)
            {
                <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="h4">Your properties</h2>
        @if (properties.Count == 0)
        {
            <div class="alert alert-info">No properties yet. Add your first one to the left.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in properties)
                {
                    <li class="list-group-item">
                        <strong>@p.Name</strong>
                        <div class="text-muted">@p.Address</div>
                        <div class="small text-muted">
                            Purchased: @FormatDate(p.PurchaseDate) · 
                            Price: <CurrencyDisplay Value="p.PurchasePrice" CurrencyCode="@p.Currency" /> · 
                            Floor area: @FormatNumber(p.FloorArea) · 
                            Currency: @p.Currency
                        </div>
                        <div class="small mb-2">@p.Notes</div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(p)">Edit</button>
                        <button class="btn btn-outline-danger btn-sm ms-1" @onclick="() => { deletingProperty = p; deleteConfirmation = string.Empty; }">Delete</button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-12">
        <div class="card card-body">
            <h2 class="h4">Property photos</h2>
            <select class="form-select mb-2" @bind="photoPropertyId">
                <option value="">Choose property</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            @if (!string.IsNullOrEmpty(photoPropertyId))
            {
                <PhotoManager Endpoint="@($"api/properties/{photoPropertyId}/photos")" />
            }
        </div>
    </div>
</div>

<ConfirmDialog Show="deletingProperty is not null"
               Title="Delete property"
               Message="@($"This permanently deletes {deletingProperty?.Name} with all its floors, rooms, surfaces, fixtures, storage locations and photos. Type the property name to confirm.")"
               ConfirmDisabled="@(deletingProperty is null || deleteConfirmation.Trim() != deletingProperty.Name)"
               OnConfirm="DeleteProperty"
               OnCancel="() => deletingProperty = null">
    <input class="form-control" @bind="deleteConfirmation" @bind:event="oninput" placeholder="@deletingProperty?.Name" />
</ConfirmDialog>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    List<PropertyDto> properties = [];

    DateOnly? propertyPurchaseDate;
    string propertyName = "", propertyAddress = "", propertyPurchasePrice = "", propertyFloorArea = "", propertyCurrency = "USD", propertyNotes = "";
    string photoPropertyId = "";

    Guid? editingPropertyId;
    PropertyDto? deletingProperty;
    string deleteConfirmation = "";
    string? error;

    async Task DeleteProperty()
    {
        if (deletingProperty is null) return;
        error = null;
        var propertyId = deletingProperty.Id;
        deletingProperty = null;
        var response = await Http.DeleteAsync($"api/properties/{propertyId}");
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        if (photoPropertyId == propertyId.ToString()) photoPropertyId = "";
        await Load();
    }

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        properties = await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties") ?? [];
        if (editingPropertyId is null) propertyCurrency = DefaultCurrency();
    }

    void StartEdit(PropertyDto property)
    {
        editingPropertyId = property.Id;
        propertyName = property.Name;
        propertyAddress = property.Address ?? "";
        propertyPurchaseDate = property.PurchaseDate;
        propertyPurchasePrice = property.PurchasePrice?.ToString() ?? "";
        propertyFloorArea = property.FloorArea?.ToString() ?? "";
        propertyCurrency = property.Currency ?? "USD";
        propertyNotes = property.Notes ?? "";
    }

    void CancelEdit()
    {
        editingPropertyId = null;
        ClearForm();
    }

    void ClearForm()
    {
        propertyName = propertyAddress = propertyPurchasePrice = propertyFloorArea = propertyNotes = "";
        propertyPurchaseDate = null;
        propertyCurrency = DefaultCurrency();
    }

    async Task SaveProperty()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(propertyName)) { error = "Property name is required."; return; }

        HttpResponseMessage response;
        if (editingPropertyId is null)
        {
            response = await Http.PostAsJsonAsync("api/properties", new PropertyInput(propertyName, propertyAddress, propertyPurchaseDate, TryDecimal(propertyPurchasePrice), TryDecimal(propertyFloorArea), propertyNotes, propertyCurrency));
        }
        else
        {
            response = await Http.PutAsJsonAsync($"api/properties/{editingPropertyId}", new PropertyInput(propertyName, propertyAddress, propertyPurchaseDate, TryDecimal(propertyPurchasePrice), TryDecimal(propertyFloorArea), propertyNotes, propertyCurrency));
        }

        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        editingPropertyId = null;
        ClearForm();
        await Load();
    }

    static string FormatDate(DateOnly? date) => date?.ToString("yyyy-MM-dd") ?? "-";
    static string FormatNumber(decimal? number) => number?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    // New properties start in the currency most existing properties use (USD when there are none).
    string DefaultCurrency() => properties.GroupBy(x => x.Currency).OrderByDescending(x => x.Count()).Select(x => x.Key).FirstOrDefault() ?? "USD";
    static decimal? TryDecimal(string? value) => decimal.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var result) ? result : null;
    static int? TryInt(string? value) => int.TryParse(value, out var result) ? result : null;
}
