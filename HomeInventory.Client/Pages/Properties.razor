@page "/properties"
@inject HttpClient Http

<PageTitle>Properties & rooms</PageTitle>
<h1>Properties & rooms</h1>
@* TODO: Add floors, property purchase details/photos, and room measurements, surfaces, fixtures, and utility views. *@
<div class="row g-4"><div class="col-lg-5"><div class="card card-body"><h2 class="h4">Add property</h2><input class="form-control mb-2" @bind="propertyName" placeholder="Property name" /><input class="form-control mb-2" @bind="propertyAddress" placeholder="Address (optional)" /><button class="btn btn-primary" @onclick="AddProperty">Save property</button></div></div><div class="col-lg-7"><h2 class="h4">Your properties</h2><ul class="list-group">@foreach(var p in properties){<li class="list-group-item"><strong>@p.Name</strong><br/><span class="text-muted">@p.Address</span></li>}</ul></div></div>
<hr class="my-4"/><div class="row g-4"><div class="col-lg-5"><div class="card card-body"><h2 class="h4">Add room</h2><select class="form-select mb-2" @bind="roomPropertyId"><option value="">Choose property</option>@foreach(var p in properties){<option value="@p.Id">@p.Name</option>}</select><input class="form-control mb-2" @bind="roomName" placeholder="Room name" /><input class="form-control mb-2" @bind="roomType" placeholder="Type (e.g. Bedroom)" /><button class="btn btn-primary" @onclick="AddRoom">Save room</button></div></div><div class="col-lg-7"><h2 class="h4">Rooms</h2><ul class="list-group">@foreach(var r in rooms){<li class="list-group-item"><strong>@r.Name</strong> <span class="text-muted">@r.Type</span></li>}</ul></div></div>
@if(error is not null){<p class="alert alert-danger mt-3">@error</p>}
@code { List<PropertyDto> properties=[];List<RoomDto> rooms=[];string propertyName="",propertyAddress="",roomPropertyId="",roomName="",roomType="";string? error;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){properties=await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties")??[];rooms=await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms")??[];}async Task AddProperty(){error=null;var r=await Http.PostAsJsonAsync("api/properties",new PropertyInput(propertyName,propertyAddress,null,null));if(!r.IsSuccessStatusCode){error=await r.Content.ReadAsStringAsync();return;}propertyName=propertyAddress="";await Load();}async Task AddRoom(){if(!Guid.TryParse(roomPropertyId,out var id)){error="Choose a property first.";return;}var r=await Http.PostAsJsonAsync("api/rooms",new RoomInput(id,roomName,roomType,null,null,null,null));if(!r.IsSuccessStatusCode){error=await r.Content.ReadAsStringAsync();return;}roomName=roomType="";await Load();} }
