@page "/properties"
@inject HttpClient Http

<PageTitle>Properties & rooms</PageTitle>
<h1>Properties & rooms</h1>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h2 class="h4">Add property</h2>
            <input class="form-control mb-2" @bind="propertyName" placeholder="Property name" />
            <input class="form-control mb-2" @bind="propertyAddress" placeholder="Address (optional)" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="propertyPurchaseDate" placeholder="YYYY-MM-DD" /></div>
                <div class="col-md-6"><input class="form-control" @bind="propertyPurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
            </div>
            <input class="form-control mb-2" @bind="propertyFloorArea" type="number" step="0.01" placeholder="Floor area" />
            <textarea class="form-control mb-2" @bind="propertyNotes" placeholder="Notes"></textarea>
            <button class="btn btn-primary" @onclick="AddProperty">Save property</button>
        </div>
    </div>
    <div class="col-lg-7">
        <h2 class="h4">Your properties</h2>
        <ul class="list-group">
            @foreach (var p in properties)
            {
                <li class="list-group-item">
                    @if (editingPropertyId == p.Id)
                    {
                        <input class="form-control mb-2" @bind="editPropertyName" />
                        <input class="form-control mb-2" @bind="editPropertyAddress" />
                        <div class="row g-2 mb-2">
                            <div class="col-md-6"><input class="form-control" @bind="editPropertyPurchaseDate" placeholder="YYYY-MM-DD" /></div>
                            <div class="col-md-6"><input class="form-control" @bind="editPropertyPurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
                        </div>
                        <input class="form-control mb-2" @bind="editPropertyFloorArea" type="number" step="0.01" placeholder="Floor area" />
                        <textarea class="form-control mb-2" @bind="editPropertyNotes"></textarea>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success btn-sm" @onclick="() => SavePropertyEdit(p.Id)">Save</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelPropertyEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <strong>@p.Name</strong>
                        <div class="text-muted">@p.Address</div>
                        <div class="small text-muted">Purchased: @FormatDate(p.PurchaseDate) · Price: @FormatMoney(p.PurchasePrice) · Floor area: @FormatNumber(p.FloorArea)</div>
                        <div class="small mb-2">@p.Notes</div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => StartPropertyEdit(p)">Edit</button>
                    }
                </li>
            }
        </ul>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="card card-body">
            <h2 class="h4">Property photos</h2>
            <select class="form-select mb-2" @bind="propertyPhotoPropertyId" @bind:after="LoadPropertyPhotos">
                <option value="">Choose property</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="propertyPhotoStorageKey" placeholder="Storage key" /></div>
                <div class="col-md-6"><input class="form-control" @bind="propertyPhotoCaption" placeholder="Caption" /></div>
            </div>
            <input class="form-control mb-2" @bind="propertyPhotoSortOrder" type="number" placeholder="Sort order" />
            <button class="btn btn-outline-primary mb-3" @onclick="AddPropertyPhoto">Add photo</button>
            <ul class="list-group">
                @foreach (var photo in propertyPhotos)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@photo.Caption</strong> <span class="text-muted">@photo.StorageKey</span></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePropertyPhoto(photo.Id)">Delete</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h2 class="h4">Add floor</h2>
            <select class="form-select mb-2" @bind="floorPropertyId">
                <option value="">Choose property</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            <input class="form-control mb-2" @bind="floorName" placeholder="Floor name" />
            <textarea class="form-control mb-2" @bind="floorNotes" placeholder="Notes"></textarea>
            <button class="btn btn-outline-primary" @onclick="AddFloor">Save floor</button>
        </div>
        <div class="card card-body mt-3">
            <h2 class="h4">Add room</h2>
            <select class="form-select mb-2" @bind="roomFloorId">
                <option value="">Choose floor</option>
                @foreach (var floor in floors) { <option value="@floor.Id">@GetFloorLabel(floor)</option> }
            </select>
            <input class="form-control mb-2" @bind="roomName" placeholder="Room name" />
            <input class="form-control mb-2" @bind="roomType" placeholder="Type (e.g. Bedroom)" />
            <div class="row g-2 mb-2">
                <div class="col-md-4"><input class="form-control" @bind="roomLength" type="number" step="0.01" placeholder="Length" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomWidth" type="number" step="0.01" placeholder="Width" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomHeight" type="number" step="0.01" placeholder="Height" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-4"><input class="form-control" @bind="roomArea" type="number" step="0.01" placeholder="Area" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomVolume" type="number" step="0.01" placeholder="Volume" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomCeilingHeight" type="number" step="0.01" placeholder="Ceiling height" /></div>
            </div>
            <input class="form-control mb-2" @bind="roomFlooring" placeholder="Flooring" />
            <input class="form-control mb-2" @bind="roomWallFinish" placeholder="Wall finish" />
            <input class="form-control mb-2" @bind="roomCeilingFinish" placeholder="Ceiling finish" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="roomWindowsCount" type="number" placeholder="Windows count" /></div>
                <div class="col-md-6"><input class="form-control" @bind="roomDoorsCount" type="number" placeholder="Doors count" /></div>
            </div>
            <textarea class="form-control mb-2" @bind="roomFixturesNotes" placeholder="Fixtures notes"></textarea>
            <textarea class="form-control mb-2" @bind="roomUtilitiesNotes" placeholder="Utilities notes"></textarea>
            <textarea class="form-control mb-2" @bind="roomNotes" placeholder="Notes"></textarea>
            <button class="btn btn-primary" @onclick="AddRoom">Save room</button>
        </div>
    </div>
    <div class="col-lg-7">
        <h2 class="h4">Rooms</h2>
        <ul class="list-group">
            @foreach (var r in rooms)
            {
                <li class="list-group-item">
                    @if (editingRoomId == r.Id)
                    {
                        <select class="form-select mb-2" @bind="editRoomFloorId">
                            <option value="">Choose floor</option>
                            @foreach (var floor in floors) { <option value="@floor.Id">@GetFloorLabel(floor)</option> }
                        </select>
                        <input class="form-control mb-2" @bind="editRoomName" />
                        <input class="form-control mb-2" @bind="editRoomType" />
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><input class="form-control" @bind="editRoomLength" type="number" step="0.01" placeholder="Length" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="editRoomWidth" type="number" step="0.01" placeholder="Width" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="editRoomHeight" type="number" step="0.01" placeholder="Height" /></div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><input class="form-control" @bind="editRoomArea" type="number" step="0.01" placeholder="Area" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="editRoomVolume" type="number" step="0.01" placeholder="Volume" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="editRoomCeilingHeight" type="number" step="0.01" placeholder="Ceiling height" /></div>
                        </div>
                        <input class="form-control mb-2" @bind="editRoomFlooring" placeholder="Flooring" />
                        <input class="form-control mb-2" @bind="editRoomWallFinish" placeholder="Wall finish" />
                        <input class="form-control mb-2" @bind="editRoomCeilingFinish" placeholder="Ceiling finish" />
                        <div class="row g-2 mb-2">
                            <div class="col-md-6"><input class="form-control" @bind="editRoomWindowsCount" type="number" placeholder="Windows count" /></div>
                            <div class="col-md-6"><input class="form-control" @bind="editRoomDoorsCount" type="number" placeholder="Doors count" /></div>
                        </div>
                        <textarea class="form-control mb-2" @bind="editRoomFixturesNotes"></textarea>
                        <textarea class="form-control mb-2" @bind="editRoomUtilitiesNotes"></textarea>
                        <textarea class="form-control mb-2" @bind="editRoomNotes"></textarea>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success btn-sm" @onclick="() => SaveRoomEdit(r.Id)">Save</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelRoomEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <strong>@r.Name</strong> <span class="text-muted">@r.Type</span>
                        <div class="small text-muted">Area: @FormatNumber(r.Area) · Volume: @FormatNumber(r.Volume) · Ceiling: @FormatNumber(r.CeilingHeight)</div>
                        <div class="small text-muted mb-2">Flooring: @r.Flooring · Wall: @r.WallFinish · Ceiling: @r.CeilingFinish</div>
                        <div class="small text-muted">Floor: @GetFloorLabel(r.FloorId)</div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => StartRoomEdit(r)">Edit</button>
                    }
                </li>
            }
        </ul>
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-12">
        <div class="card card-body">
            <h2 class="h4">Surfaces</h2>
            <select class="form-select mb-2" @bind="surfaceRoomId" @bind:after="LoadSurfaces">
                <option value="">Choose room</option>
                @foreach (var room in rooms) { <option value="@room.Id">@room.Name</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="surfaceName" placeholder="Surface name" /></div>
                <div class="col-md-6"><input class="form-control" @bind="surfaceType" placeholder="Type (wall, ceiling, flooring, trim)" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="surfaceSortOrder" type="number" placeholder="Sort order" /></div>
                <div class="col-md-6"><input class="form-control" @bind="surfaceNotes" placeholder="Notes" /></div>
            </div>
            <button class="btn btn-outline-primary mb-3" @onclick="AddSurface">Add surface</button>
            <ul class="list-group">
                @foreach (var surface in surfaces)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@surface.Name</strong> <span class="text-muted">@surface.SurfaceType</span></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSurface(surface.Id)">Delete</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card card-body">
            <h2 class="h4">Fixtures</h2>
            <select class="form-select mb-2" @bind="fixtureRoomId" @bind:after="LoadFixtures">
                <option value="">Choose room</option>
                @foreach (var room in rooms) { <option value="@room.Id">@room.Name</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureName" placeholder="Fixture name" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureType" placeholder="Fixture type" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureManufacturer" placeholder="Manufacturer" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureModel" placeholder="Model" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureSerialNumber" placeholder="Serial number" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixturePurchaseDate" placeholder="Purchase date" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixturePurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureCurrentValue" type="number" step="0.01" placeholder="Current value" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureWarranty" placeholder="Warranty" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureManualUrl" placeholder="Manual URL" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureInstallerName" placeholder="Installer" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureInstallationDate" placeholder="Installation date" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixtureMaintenanceSchedule" placeholder="Maintenance schedule" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureLastMaintenanceDate" placeholder="Last maintenance" /></div>
            </div>
            <input class="form-control mb-2" @bind="fixtureCondition" placeholder="Condition" />
            <textarea class="form-control mb-2" @bind="fixtureNotes" placeholder="Notes"></textarea>
            <button class="btn btn-outline-primary mb-3" @onclick="SaveFixture">@((editingFixtureId is null) ? "Add fixture" : "Update fixture")</button>
            @if (editingFixtureId is not null)
            {
                <button class="btn btn-outline-secondary mb-3 ms-2" @onclick="CancelFixtureEdit">Cancel</button>
            }
            <ul class="list-group">
                @foreach (var fixture in fixtures)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <span><strong>@fixture.Name</strong> <span class="text-muted">@fixture.Type</span><br /><span class="small text-muted">@fixture.Manufacturer @fixture.Model</span></span>
                        <span>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartFixtureEdit(fixture)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFixture(fixture.Id)">Delete</button>
                        </span>
                    </li>
                }
            </ul>
        </div>
        <div class="card card-body mt-3">
            <h2 class="h4">Fixture photos</h2>
            <select class="form-select mb-2" @bind="fixturePhotoFixtureId" @bind:after="LoadFixturePhotos">
                <option value="">Choose fixture</option>
                @foreach (var fixture in fixtures) { <option value="@fixture.Id">@fixture.Name</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-7"><input class="form-control" @bind="fixturePhotoStorageKey" placeholder="Storage key" /></div>
                <div class="col-md-5"><input class="form-control" @bind="fixturePhotoCaption" placeholder="Caption" /></div>
            </div>
            <input class="form-control mb-2" @bind="fixturePhotoSortOrder" type="number" placeholder="Sort order" />
            <button class="btn btn-outline-primary mb-3" @onclick="AddFixturePhoto">Add photo</button>
            <ul class="list-group">
                @foreach (var photo in fixturePhotos)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@photo.Caption</strong> <span class="text-muted">@photo.StorageKey</span></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFixturePhoto(photo.Id)">Delete</button>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-body">
            <h2 class="h4">Assets</h2>
            <select class="form-select mb-2" @bind="assetPropertyId" @bind:after="LoadAssets">
                <option value="">Choose property</option>
                @foreach (var p in properties) { <option value="@p.Id">@p.Name</option> }
            </select>
            <select class="form-select mb-2" @bind="assetRoomId">
                <option value="">Choose room</option>
                @foreach (var room in RoomsForProperty(Guid.TryParse(assetPropertyId, out var propertyId) ? propertyId : (Guid?)null)) { <option value="@room.Id">@room.Name</option> }
            </select>
            <select class="form-select mb-2" @bind="assetStorageLocationId">
                <option value="">Choose storage location</option>
                @foreach (var location in LocationsForProperty(Guid.TryParse(assetPropertyId, out var propertyId) ? propertyId : (Guid?)null)) { <option value="@location.Id">@location.Path</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="assetName" placeholder="Asset name" /></div>
                <div class="col-md-6"><input class="form-control" @bind="assetCategory" placeholder="Category" /></div>
            </div>
            <input class="form-control mb-2" @bind="assetDescription" placeholder="Description" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="assetBrand" placeholder="Brand" /></div>
                <div class="col-md-6"><input class="form-control" @bind="assetModel" placeholder="Model" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="assetSerialNumber" placeholder="Serial number" /></div>
                <div class="col-md-6"><input class="form-control" @bind="assetPurchaseDate" placeholder="Purchase date" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="assetPurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
                <div class="col-md-6"><input class="form-control" @bind="assetCurrentValue" type="number" step="0.01" placeholder="Current value" /></div>
            </div>
            <input class="form-control mb-2" @bind="assetCondition" placeholder="Condition" />
            <textarea class="form-control mb-2" @bind="assetNotes" placeholder="Notes"></textarea>
            <button class="btn btn-outline-primary mb-3" @onclick="SaveAsset">@((editingAssetId is null) ? "Add asset" : "Update asset")</button>
            @if (editingAssetId is not null)
            {
                <button class="btn btn-outline-secondary mb-3 ms-2" @onclick="CancelAssetEdit">Cancel</button>
            }
            <ul class="list-group">
                @foreach (var asset in assets)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <span><strong>@asset.Name</strong> <span class="text-muted">@asset.Category</span><br /><span class="small text-muted">@asset.LocationPath</span></span>
                        <span>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartAssetEdit(asset)">Edit</button>
                            <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => ArchiveAsset(asset.Id)">Archive</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsset(asset.Id)">Delete</button>
                        </span>
                    </li>
                }
            </ul>
        </div>
        <div class="card card-body mt-3">
            <h2 class="h4">Asset photos</h2>
            <select class="form-select mb-2" @bind="assetPhotoAssetId" @bind:after="LoadAssetPhotos">
                <option value="">Choose asset</option>
                @foreach (var asset in assets) { <option value="@asset.Id">@asset.Name</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-7"><input class="form-control" @bind="assetPhotoStorageKey" placeholder="Storage key" /></div>
                <div class="col-md-5"><input class="form-control" @bind="assetPhotoCaption" placeholder="Caption" /></div>
            </div>
            <input class="form-control mb-2" @bind="assetPhotoSortOrder" type="number" placeholder="Sort order" />
            <button class="btn btn-outline-primary mb-3" @onclick="AddAssetPhoto">Add photo</button>
            <ul class="list-group">
                @foreach (var photo in assetPhotos)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@photo.Caption</strong> <span class="text-muted">@photo.StorageKey</span></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssetPhoto(photo.Id)">Delete</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card card-body">
            <h2 class="h4">Paint library</h2>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="paintBrand" placeholder="Brand" /></div>
                <div class="col-md-6"><input class="form-control" @bind="paintColorName" placeholder="Colour name" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="paintColorCode" placeholder="Colour code" /></div>
                <div class="col-md-6"><input class="form-control" @bind="paintFinish" placeholder="Finish" /></div>
            </div>
            <textarea class="form-control mb-2" @bind="paintNotes" placeholder="Notes"></textarea>
            <button class="btn btn-primary mb-3" @onclick="SavePaint">@((editingPaintId is null) ? "Add paint" : "Update paint")</button>
            @if (editingPaintId is not null)
            {
                <button class="btn btn-outline-secondary mb-3 ms-2" @onclick="CancelPaintEdit">Cancel</button>
            }
            <ul class="list-group">
                @foreach (var paint in paints)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@paint.Brand</strong> @paint.ColorName <span class="text-muted">@paint.ColorCode @paint.Finish</span></span>
                        <span>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartPaintEdit(paint)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePaint(paint.Id)">Delete</button>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-body">
            <h2 class="h4">Room paint colours</h2>
            <select class="form-select mb-2" @bind="roomPaintRoomId" @bind:after="LoadRoomPaints">
                <option value="">Choose room</option>
                @foreach (var room in rooms) { <option value="@room.Id">@room.Name</option> }
            </select>
            <select class="form-select mb-2" @bind="roomPaintPaintId">
                <option value="">Choose paint</option>
                @foreach (var paint in paints) { <option value="@paint.Id">@paint.Brand @paint.ColorName (@paint.ColorCode)</option> }
            </select>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="roomPaintSurface" placeholder="Surface (e.g. North wall)" /></div>
                <div class="col-md-6"><input class="form-control" @bind="roomPaintSortOrder" type="number" placeholder="Sort order" /></div>
            </div>
            <button class="btn btn-outline-primary mb-3" @onclick="AddRoomPaint">Assign paint</button>
            <ul class="list-group">
                @foreach (var item in roomPaints)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@item.Brand</strong> @item.ColorName <span class="text-muted">@item.ColorCode @item.Finish · @item.Surface</span></span>
