@page "/import-export"
@inject HttpClient Http
@inject IJSRuntime Js

<PageTitle>Import & backup</PageTitle>
<h1>Import & backup</h1>
<div class="row g-4"><div class="col-lg-6"><div class="card card-body"><h2 class="h4">Backup</h2><p>Download a complete JSON copy of your active inventory. Keep it somewhere safe.</p><button class="btn btn-primary" @onclick="Export">Download backup</button></div></div><div class="col-lg-6"><div class="card card-body"><h2 class="h4">Import AI-generated JSON</h2><p>Ask ChatGPT to produce the documented schema, select its JSON file, review the preview, then confirm.</p><InputFile OnChange="ReadFile" accept="application/json,.json" />@if(preview is not null){<div class="mt-3"><strong>@(preview.IsValid ? "Ready to import" : "Fix the file first")</strong><p>@preview.Properties properties · @preview.Floors floors · @preview.Rooms rooms · @preview.Surfaces surfaces · @preview.Fixtures fixtures · @preview.StorageLocations locations · @preview.Assets assets · @preview.Paints paints · @preview.Photos photos</p>@foreach(var error in preview.Errors){<p class="text-danger">@error</p>}@if(preview.ExistingRecords>0){<p class="text-warning">@preview.ExistingRecords record(s) are already in your inventory (matched by backup ID) and will be skipped. Only new records are added.</p>}@if(preview.IsValid){<button class="btn btn-success" @onclick="Confirm">Import reviewed records</button>}</div>}</div></div></div>
<h2 class="h4 mt-4">JSON contract</h2><p>Use <code>schemaVersion: 1</code> and arrays named <code>properties</code>, <code>floors</code>, <code>rooms</code>, <code>surfaces</code>, <code>storageLocations</code>, <code>assets</code> and <code>propertyPhotos</code>, plus the optional <code>fixtures</code>, <code>assetPhotos</code>, <code>paints</code>, <code>roomPaints</code>, <code>roomPhotos</code> and <code>fixturePhotos</code>. Imported paints that match an existing paint (brand, colour name and code) are reused, not duplicated. Every record needs a unique <code>externalId</code>; child records reference their parent using the relevant <code>*ExternalId</code> property. Export an empty backup to get a valid example.</p>
@if(message is not null){<p class="alert alert-info mt-3">@message</p>}
@code {InventoryExport? inventory;ImportPreviewDto? preview;string? message;async Task ReadFile(InputFileChangeEventArgs e){try{using var stream=e.File.OpenReadStream(5_000_000);inventory=await JsonSerializer.DeserializeAsync<InventoryExport>(stream,new JsonSerializerOptions(JsonSerializerDefaults.Web));if(inventory is null){message="That file did not contain inventory JSON.";return;}var response=await Http.PostAsJsonAsync("api/import/preview",inventory);preview=await response.Content.ReadFromJsonAsync<ImportPreviewDto>();message=null;}catch(Exception ex){message=$"Could not read the file: {ex.Message}";}}async Task Confirm(){if(inventory is null)return;var skipped=preview?.DuplicateExternalIds.ToList()??[];var response=await Http.PostAsJsonAsync("api/import/confirm",new {inventory,skipExternalIds=skipped});message=response.IsSuccessStatusCode?"Import complete.":await response.Content.ReadAsStringAsync();}async Task Export(){var json=await Http.GetStringAsync("api/export");await Js.InvokeVoidAsync("downloadText", "home-inventory-backup.json", json);}}
