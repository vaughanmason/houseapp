@page "/fixtures"
@inject HttpClient Http

<PageTitle>@(Category == "Utility" ? "Utilities" : "Fixtures")</PageTitle>

<div class="mb-4 d-flex justify-content-between align-items-start">
    <div>
        <h1>@(Category == "Utility" ? "Utilities" : Category == "Fixture" ? "Fixtures" : "Fixtures & utilities")</h1>
        <p class="lead">Permanent items in your rooms, and utilities such as meters, solar, inverters and internet.</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-sm @(Category is null ? "btn-secondary" : "btn-outline-secondary")" href="fixtures">All</a>
        <a class="btn btn-sm @(Category == "Fixture" ? "btn-secondary" : "btn-outline-secondary")" href="fixtures?category=Fixture">Fixtures</a>
        <a class="btn btn-sm @(Category == "Utility" ? "btn-secondary" : "btn-outline-secondary")" href="fixtures?category=Utility">Utilities</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card card-body">
            <h2 class="h4">@(editingFixtureId is null ? $"Add {fixtureCategory.ToLowerInvariant()}" : $"Edit {fixtureCategory.ToLowerInvariant()}")</h2>
            <div class="btn-group mb-2" role="group">
                <input type="radio" class="btn-check" name="category" id="cat-fixture" checked="@(fixtureCategory == "Fixture")" @onchange="@(() => fixtureCategory = "Fixture")" />
                <label class="btn btn-outline-primary btn-sm" for="cat-fixture">Fixture</label>
                <input type="radio" class="btn-check" name="category" id="cat-utility" checked="@(fixtureCategory == "Utility")" @onchange="@(() => fixtureCategory = "Utility")" />
                <label class="btn btn-outline-primary btn-sm" for="cat-utility">Utility</label>
            </div>
            <select class="form-select mb-2" @bind="roomId">
                <option value="">Choose room</option>
                @foreach (var room in rooms.OrderBy(r => r.Name)) { <option value="@room.Id">@room.Name</option> }
            </select>
            <input class="form-control mb-2" @bind="fixtureName" placeholder="@(fixtureCategory == "Utility" ? "Name (e.g. Main electricity meter)" : "Fixture name")" />
            <input class="form-control mb-2" @bind="fixtureType" list="fixture-types" placeholder="Type" />
            <datalist id="fixture-types">
                @foreach (var type in fixtureCategory == "Utility" ? UtilityTypes : FixtureTypes) { <option value="@type" /> }
            </datalist>
            @if (fixtureCategory == "Utility")
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-6"><input class="form-control" @bind="fixtureProvider" list="contact-names" placeholder="Provider (e.g. City Power, ISP)" /></div>
                    <div class="col-md-6"><input class="form-control" @bind="fixtureAccountNumber" placeholder="Account / meter number" /></div>
                </div>
            }

            <h5 class="mt-3">Identification</h5>
            <input class="form-control mb-2" @bind="fixtureManufacturer" list="brands" placeholder="Manufacturer" />
            <input class="form-control mb-2" @bind="fixtureModel" placeholder="Model" />
            <input class="form-control mb-2" @bind="fixtureSerialNumber" placeholder="Serial number" />

            <h5 class="mt-3">Financial</h5>
            <label class="form-label small text-muted mb-1" for="fixture-purchase-date">Purchase date</label>
            <input class="form-control mb-2" id="fixture-purchase-date" type="date" @bind="fixturePurchaseDate" />
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="fixturePurchasePrice" type="number" step="0.01" placeholder="Purchase price" /></div>
                <div class="col-md-6"><input class="form-control" @bind="fixtureCurrentValue" type="number" step="0.01" placeholder="Current value" /></div>
            </div>

            <h5 class="mt-3">Maintenance</h5>
            <input class="form-control mb-2" @bind="fixtureWarranty" placeholder="Warranty" />
            <input class="form-control mb-2" @bind="fixtureManualUrl" placeholder="Manual URL" />
            <input class="form-control mb-2" @bind="fixtureInstallerName" list="contact-names" placeholder="Installer" />
            <label class="form-label small text-muted mb-1" for="fixture-installation-date">Installation date</label>
            <input class="form-control mb-2" id="fixture-installation-date" type="date" @bind="fixtureInstallationDate" />
            <p class="small text-muted mb-2">Schedule servicing on the <a href="maintenance">Maintenance</a> page.</p>

            <h5 class="mt-3">Details</h5>
            <input class="form-control mb-2" @bind="fixtureCondition" placeholder="Condition" />
            <textarea class="form-control mb-2" @bind="fixtureNotes" placeholder="Notes"></textarea>

            <button class="btn btn-primary" @onclick="SaveFixture">@(editingFixtureId is null ? "Add fixture" : "Update fixture")</button>
            @if (editingFixtureId is not null)
            {
                <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <h2 class="h4">By room</h2>
        @if (rooms.Count == 0)
        {
            <div class="alert alert-info">No rooms found. <a href="rooms">Create a room first</a>.</div>
        }
        else if (Visible().Count == 0)
        {
            <div class="alert alert-info">Nothing here yet. Add one to the left.</div>
        }
        else
        {
            @foreach (var room in rooms.Where(r => Visible().Any(f => f.RoomId == r.Id)).OrderBy(r => r.Name))
            {
                <div class="mb-3">
                    <h5>@room.Name</h5>
                    <ul class="list-group">
                        @foreach (var fixture in Visible().Where(f => f.RoomId == room.Id).OrderBy(f => f.Name))
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@fixture.Name</strong> <span class="text-muted">@fixture.Type</span>
                                        @if (fixture.Category == "Utility") { <span class="badge text-bg-info">Utility</span> }
                                        @if (!string.IsNullOrEmpty(fixture.Provider) || !string.IsNullOrEmpty(fixture.AccountNumber))
                                        {
                                            <div class="small text-muted">@fixture.Provider @(string.IsNullOrEmpty(fixture.AccountNumber) ? "" : $"· account {fixture.AccountNumber}")</div>
                                        }
                                        <div class="small text-muted">
                                            @if (!string.IsNullOrEmpty(fixture.Manufacturer) || !string.IsNullOrEmpty(fixture.Model))
                                            {
                                                <div>@fixture.Manufacturer @fixture.Model</div>
                                            }
                                        </div>
                                        @if (fixture.PurchasePrice.HasValue || fixture.CurrentValue.HasValue)
                                        {
                                            <div class="small text-muted">
                                                Purchase: <CurrencyDisplay Value="fixture.PurchasePrice" CurrencyCode="@GetPropertyCurrency(fixture)" /> · 
                                                Current: <CurrencyDisplay Value="fixture.CurrentValue" CurrencyCode="@GetPropertyCurrency(fixture)" />
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(fixture.Condition))
                                        {
                                            <div class="small text-muted">Condition: @fixture.Condition</div>
                                        }
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(fixture)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => pending = new("Delete fixture", $"Delete {fixture.Name}? Its photos and maintenance tasks are deleted too; attached documents are kept.", () => DeleteFixture(fixture.Id)))">Delete</button>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>

<hr class="my-4" />

<div class="row g-4">
    <div class="col-12">
        <div class="card card-body">
            <h2 class="h4">Fixture photos</h2>
            <select class="form-select mb-2" @bind="photoFixtureId">
                <option value="">Choose fixture</option>
                @foreach (var fixture in fixtures.OrderBy(f => f.Name)) { <option value="@fixture.Id">@fixture.Name</option> }
            </select>
            @if (!string.IsNullOrEmpty(photoFixtureId))
            {
                <PhotoManager Endpoint="@($"api/fixtures/{photoFixtureId}/photos")" />
            }
        </div>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<LookupLists />

<ConfirmDialog Show="pending is not null" Title="@(pending?.Title ?? string.Empty)" Message="@(pending?.Message ?? string.Empty)" OnConfirm="RunPending" OnCancel="() => pending = null" />

@code {
    PendingConfirmation? pending;

    async Task RunPending()
    {
        var action = pending;
        pending = null;
        await PendingConfirmation.RunAsync(action);
    }

    List<RoomDto> rooms = [];
    List<FixtureDto> fixtures = [];
    List<PropertyDto> properties = [];
    List<FloorDto> floors = [];

    string roomId = "", fixtureName = "", fixtureType = "", fixtureManufacturer = "", fixtureModel = "", fixtureSerialNumber = "";
    DateOnly? fixturePurchaseDate, fixtureInstallationDate;
    string fixturePurchasePrice = "", fixtureCurrentValue = "", fixtureWarranty = "", fixtureManualUrl = "";
    string fixtureInstallerName = "", fixtureCondition = "", fixtureNotes = "";
    string photoFixtureId = "", fixtureCategory = "Fixture", fixtureProvider = "", fixtureAccountNumber = "";

    static readonly string[] FixtureTypes = ["Sink", "Toilet", "Shower", "Bath", "Built-in cupboard", "Window", "Door", "Air conditioner", "Ceiling fan", "Light fitting", "Alarm", "Oven", "Hob", "Extractor"];
    static readonly string[] UtilityTypes = ["Electrical panel", "Electricity meter", "Water meter", "Gas meter", "Solar panels", "Battery", "Inverter", "Generator", "Geyser", "Heat pump", "Borehole", "Pool pump", "Internet", "Water tank"];

    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    List<FixtureDto> Visible() => Category is null ? fixtures : fixtures.Where(f => f.Category == Category).ToList();

    protected override void OnParametersSet()
    {
        if (Category is not null) Category = Category.Equals("Utility", StringComparison.OrdinalIgnoreCase) ? "Utility" : "Fixture";
        if (editingFixtureId is null) fixtureCategory = Category ?? fixtureCategory;
    }

    Guid? editingFixtureId;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        properties = await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties") ?? [];
        floors = await Http.GetFromJsonAsync<List<FloorDto>>("api/floors") ?? [];
        rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? [];
        fixtures = await Http.GetFromJsonAsync<List<FixtureDto>>("api/fixtures") ?? [];
    }

    void StartEdit(FixtureDto fixture)
    {
        editingFixtureId = fixture.Id;
        roomId = fixture.RoomId.ToString();
        fixtureName = fixture.Name;
        fixtureType = fixture.Type;
        fixtureManufacturer = fixture.Manufacturer ?? "";
        fixtureModel = fixture.Model ?? "";
        fixtureSerialNumber = fixture.SerialNumber ?? "";
        fixturePurchaseDate = fixture.PurchaseDate;
        fixturePurchasePrice = fixture.PurchasePrice?.ToString() ?? "";
        fixtureCurrentValue = fixture.CurrentValue?.ToString() ?? "";
        fixtureWarranty = fixture.Warranty ?? "";
        fixtureManualUrl = fixture.ManualUrl ?? "";
        fixtureInstallerName = fixture.InstallerName ?? "";
        fixtureInstallationDate = fixture.InstallationDate;
        fixtureCondition = fixture.Condition ?? "";
        fixtureNotes = fixture.Notes ?? "";
        fixtureCategory = fixture.Category;
        fixtureProvider = fixture.Provider ?? "";
        fixtureAccountNumber = fixture.AccountNumber ?? "";
    }

    void CancelEdit()
    {
        editingFixtureId = null;
        ClearForm();
    }

    void ClearForm()
    {
        roomId = fixtureName = fixtureType = fixtureManufacturer = fixtureModel = fixtureSerialNumber = "";
        fixturePurchaseDate = fixtureInstallationDate = null;
        fixturePurchasePrice = fixtureCurrentValue = fixtureWarranty = fixtureManualUrl = "";
        fixtureInstallerName = fixtureCondition = fixtureNotes = "";
        fixtureProvider = fixtureAccountNumber = "";
        fixtureCategory = Category ?? "Fixture";
    }

    async Task SaveFixture()
    {
        error = null;
        if (!Guid.TryParse(roomId, out var parsedRoomId)) { error = "Choose a room first."; return; }
        if (string.IsNullOrWhiteSpace(fixtureName) || string.IsNullOrWhiteSpace(fixtureType)) { error = "Name and type are required."; return; }

        var response = editingFixtureId is null
            ? await Http.PostAsJsonAsync($"api/rooms/{parsedRoomId}/fixtures", new FixtureInput(parsedRoomId, fixtureName, fixtureType, fixtureManufacturer, fixtureModel, fixtureSerialNumber, fixturePurchaseDate, TryDecimal(fixturePurchasePrice), TryDecimal(fixtureCurrentValue), fixtureWarranty, fixtureManualUrl, fixtureInstallerName, fixtureInstallationDate, fixtureCondition, fixtureNotes, fixtureCategory, fixtureCategory == "Utility" ? fixtureProvider : null, fixtureCategory == "Utility" ? fixtureAccountNumber : null))
            : await Http.PutAsJsonAsync($"api/fixtures/{editingFixtureId}", new FixtureInput(parsedRoomId, fixtureName, fixtureType, fixtureManufacturer, fixtureModel, fixtureSerialNumber, fixturePurchaseDate, TryDecimal(fixturePurchasePrice), TryDecimal(fixtureCurrentValue), fixtureWarranty, fixtureManualUrl, fixtureInstallerName, fixtureInstallationDate, fixtureCondition, fixtureNotes, fixtureCategory, fixtureCategory == "Utility" ? fixtureProvider : null, fixtureCategory == "Utility" ? fixtureAccountNumber : null));

        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        editingFixtureId = null;
        ClearForm();
        fixtures = await Http.GetFromJsonAsync<List<FixtureDto>>("api/fixtures") ?? [];
    }

    async Task DeleteFixture(Guid fixtureId)
    {
        error = null;
        var response = await Http.DeleteAsync($"api/fixtures/{fixtureId}");
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        fixtures = await Http.GetFromJsonAsync<List<FixtureDto>>("api/fixtures") ?? [];
    }

    string? GetPropertyCurrency(FixtureDto fixture)
    {
        var room = rooms.FirstOrDefault(r => r.Id == fixture.RoomId);
        if (room is null) return "USD";
        var floor = floors.FirstOrDefault(f => f.Id == room.FloorId);
        if (floor is null) return "USD";
        var property = properties.FirstOrDefault(p => p.Id == floor.PropertyId);
        return property?.Currency ?? "USD";
    }

    static decimal? TryDecimal(string? value) => decimal.TryParse(value, out var result) ? result : null;
    static int? TryInt(string? value) => int.TryParse(value, out var result) ? result : null;
}
