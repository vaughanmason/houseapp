@page "/storage"
@inject HttpClient Http

<PageTitle>Storage</PageTitle>
<h1>Storage locations</h1><p class="text-muted">Build a location tree such as Garage → Shelf B → Box 12.</p>
@* TODO: Add QR-code generation and scanning for storage locations once the identifier API is available. *@
<div class="card card-body mb-4"><div class="row g-2"><div class="col-md-3"><select class="form-select" @bind="propertyId"><option value="">Property</option>@foreach(var p in properties){<option value="@p.Id">@p.Name</option>}</select></div><div class="col-md-3"><select class="form-select" @bind="parentId"><option value="">Top-level location</option>@foreach(var l in locations.Where(x=>x.PropertyId.ToString()==propertyId)){<option value="@l.Id">@l.Path</option>}</select></div><div class="col-md-3"><input class="form-control" @bind="name" placeholder="Location name" /></div><div class="col-md-2"><input class="form-control" @bind="type" placeholder="Type" /></div><div class="col-md-1"><button class="btn btn-primary w-100" @onclick="Add">Add</button></div></div></div>
<ul class="list-group">@foreach(var l in locations){<li class="list-group-item"><strong>@l.Path</strong> <span class="text-muted">@l.Type</span></li>}</ul>@if(error is not null){<p class="alert alert-danger mt-3">@error</p>}
@code {List<PropertyDto> properties=[];List<StorageLocationDto> locations=[];string propertyId="",parentId="",name="",type="";string? error;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){properties=await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties")??[];locations=await Http.GetFromJsonAsync<List<StorageLocationDto>>("api/locations")??[];}async Task Add(){if(!Guid.TryParse(propertyId,out var p)){error="Choose a property.";return;}var parent=Guid.TryParse(parentId,out var par)?par:(Guid?)null;var r=await Http.PostAsJsonAsync("api/locations",new StorageLocationInput(p,parent,name,type));if(!r.IsSuccessStatusCode){error=await r.Content.ReadAsStringAsync();return;}name=type=parentId="";await Load();}}
