@page "/assets"
@inject HttpClient Http

<PageTitle>Assets</PageTitle><h1>Assets</h1>
@* TODO: Add asset editing, movement, full metadata, photo/document upload, and barcode/QR workflows after their API support is implemented. *@
<div class="card card-body mb-4"><h2 class="h4">Add asset</h2><div class="row g-2"><div class="col-md-4"><select class="form-select" @bind="propertyId"><option value="">Property</option>@foreach(var p in properties){<option value="@p.Id">@p.Name</option>}</select></div><div class="col-md-4"><input class="form-control" @bind="name" placeholder="Asset name" /></div><div class="col-md-4"><input class="form-control" @bind="category" placeholder="Category" /></div><div class="col-md-4"><input class="form-control" @bind="brand" placeholder="Brand" /></div><div class="col-md-4"><input class="form-control" @bind="model" placeholder="Model" /></div><div class="col-md-4"><input class="form-control" @bind="value" type="number" step="0.01" placeholder="Current value" /></div><div class="col-12"><select class="form-select" @bind="locationId"><option value="">No storage location</option>@foreach(var l in locations.Where(x=>x.PropertyId.ToString()==propertyId)){<option value="@l.Id">@l.Path</option>}</select></div><div class="col-12"><button class="btn btn-primary" @onclick="Add">Save asset</button></div></div></div>
<table class="table align-middle"><thead><tr><th>Asset</th><th>Location</th><th>Value</th><th></th></tr></thead><tbody>@foreach(var asset in assets){<tr><td><strong>@asset.Name</strong><br/><span class="text-muted">@asset.Category · @asset.Brand @asset.Model</span></td><td>@asset.LocationPath</td><td>@asset.CurrentValue?.ToString("C")</td><td><button class="btn btn-sm btn-outline-secondary" @onclick="()=>Archive(asset.Id)">Archive</button></td></tr>}</tbody></table>@if(error is not null){<p class="alert alert-danger">@error</p>}
@code {List<PropertyDto> properties=[];List<StorageLocationDto> locations=[];List<AssetDto> assets=[];string propertyId="",locationId="",name="",category="",brand="",model="",value="";string? error;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){properties=await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties")??[];locations=await Http.GetFromJsonAsync<List<StorageLocationDto>>("api/locations")??[];assets=await Http.GetFromJsonAsync<List<AssetDto>>("api/assets?archived=false")??[];}async Task Add(){if(!Guid.TryParse(propertyId,out var p)){error="Choose a property.";return;}var l=Guid.TryParse(locationId,out var parsed)?parsed:(Guid?)null;decimal? v=decimal.TryParse(value,out var d)?d:null;var r=await Http.PostAsJsonAsync("api/assets",new AssetInput(p,null,l,name,category,null,brand,model,null,null,null,v,null,null));if(!r.IsSuccessStatusCode){error=await r.Content.ReadAsStringAsync();return;}name=category=brand=model=value=locationId="";await Load();}async Task Archive(Guid id){await Http.PostAsync($"api/assets/{id}/archive",null);await Load();}}
