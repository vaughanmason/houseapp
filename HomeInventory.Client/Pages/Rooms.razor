@page "/rooms"
@inject HttpClient Http

<PageTitle>Rooms & Surfaces</PageTitle>

<div class="mb-4">
    <h1>Rooms & Surfaces</h1>
    <p class="lead">Manage rooms, surfaces, and room details.</p>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h2 class="h4">@(editingRoomId is null ? "Add room" : "Edit room")</h2>
            <select class="form-select mb-2" @bind="floorId">
                <option value="">Choose floor</option>
                @foreach (var floor in floors)
                {
                    var prop = properties.FirstOrDefault(p => p.Id == floor.PropertyId);
                    <option value="@floor.Id">@prop?.Name - @floor.Name</option>
                }
            </select>
            <input class="form-control mb-2" @bind="roomName" placeholder="Room name" />
            <input class="form-control mb-2" @bind="roomType" placeholder="Type (e.g., Bedroom)" />
            
            <h5 class="mt-3">Dimensions</h5>
            <div class="row g-2 mb-2">
                <div class="col-md-4"><input class="form-control" @bind="roomLength" type="number" step="0.01" placeholder="Length" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomWidth" type="number" step="0.01" placeholder="Width" /></div>
                <div class="col-md-4"><input class="form-control" @bind="roomHeight" type="number" step="0.01" placeholder="Height" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="roomArea" type="number" step="0.01" placeholder="Area" /></div>
                <div class="col-md-6"><input class="form-control" @bind="roomVolume" type="number" step="0.01" placeholder="Volume" /></div>
            </div>
            <input class="form-control mb-2" @bind="roomCeilingHeight" type="number" step="0.01" placeholder="Ceiling height" />

            <h5 class="mt-3">Finishes</h5>
            <input class="form-control mb-2" @bind="roomFlooring" placeholder="Flooring" />
            <input class="form-control mb-2" @bind="roomWallFinish" placeholder="Wall finish" />
            <input class="form-control mb-2" @bind="roomCeilingFinish" placeholder="Ceiling finish" />
            <input class="form-control mb-2" @bind="roomPaintDetails" placeholder="Paint details" />

            <h5 class="mt-3">Details</h5>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input class="form-control" @bind="roomWindowsCount" type="number" placeholder="Windows count" /></div>
                <div class="col-md-6"><input class="form-control" @bind="roomDoorsCount" type="number" placeholder="Doors count" /></div>
            </div>
            <textarea class="form-control mb-2" @bind="roomFixturesNotes" placeholder="Fixtures notes"></textarea>
            <textarea class="form-control mb-2" @bind="roomUtilitiesNotes" placeholder="Utilities notes"></textarea>
            <textarea class="form-control mb-2" @bind="roomNotes" placeholder="General notes"></textarea>

            <button class="btn btn-primary" @onclick="SaveRoom">@(editingRoomId is null ? "Add room" : "Update room")</button>
            @if (editingRoomId is not null)
            {
                <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="h4">Rooms by floor</h2>
        @if (floors.Count == 0)
        {
            <div class="alert alert-info">No floors found. <a href="floors">Create a floor first</a>.</div>
        }
        else if (rooms.Count == 0)
        {
            <div class="alert alert-info">No rooms yet. Add one to the left.</div>
        }
        else
        {
            @foreach (var floor in floors.OrderBy(f => f.Name))
            {
                var floorRooms = rooms.Where(r => r.FloorId == floor.Id).OrderBy(r => r.Name).ToList();
                if (floorRooms.Count > 0)
                {
                    var prop = properties.FirstOrDefault(p => p.Id == floor.PropertyId);
                    <div class="mb-3">
                        <h5>@prop?.Name - @floor.Name</h5>
                        <ul class="list-group">
                            @foreach (var room in floorRooms)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@room.Name</strong> <span class="text-muted">@room.Type</span>
                                            <div class="small text-muted">
                                                Area: @FormatNumber(room.Area) · 
                                                Volume: @FormatNumber(room.Volume) · 
                                                Ceiling: @FormatNumber(room.CeilingHeight)
                                            </div>
                                            <div class="small text-muted">
                                                Flooring: @room.Flooring · Wall: @room.WallFinish · Ceiling: @room.CeilingFinish
                                            </div>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(room)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoom(room.Id)">Delete</button>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
    </div>
</div>

<hr class="my-4" />

<div class="mb-3">
    <h2 class="h4">Room details</h2>
    <select class="form-select" @bind="selectedRoomId" @bind:after="LoadRoomDetails">
        <option value="">Choose room</option>
        @foreach (var room in rooms.OrderBy(r => RoomLabel(r))) { <option value="@room.Id">@RoomLabel(room)</option> }
    </select>
</div>

@if (!string.IsNullOrEmpty(selectedRoomId))
{
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card card-body">
                <h3 class="h5">@(editingSurfaceId is null ? "Add surface" : "Edit surface")</h3>
                <div class="row g-2 mb-2">
                    <div class="col-md-7"><input class="form-control" @bind="surfaceName" placeholder="Surface name (e.g. North wall)" /></div>
                    <div class="col-md-5">
                        <select class="form-select" @bind="surfaceType">
                            @foreach (var type in SurfaceTypes) { <option value="@type">@type</option> }
                        </select>
                    </div>
                </div>
                @if (surfaceType == "flooring")
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfaceMaterial" placeholder="Material (tile, vinyl, oak...)" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceColorName" placeholder="Colour" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfaceManufacturer" placeholder="Manufacturer" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceProductName" placeholder="Product name" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfaceSupplier" placeholder="Supplier" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceInstallationDate" type="date" title="Installation date" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfaceWarranty" placeholder="Warranty" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceInvoice" placeholder="Invoice reference" /></div>
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfacePaintBrand" placeholder="Paint brand" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceColorName" placeholder="Colour name" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><input class="form-control" @bind="surfaceColorCode" placeholder="Colour code" /></div>
                        <div class="col-md-6"><input class="form-control" @bind="surfaceFinish" placeholder="Finish (e.g. eggshell)" /></div>
                    </div>
                    @if (surfaceType != "trim")
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><input class="form-control" @bind="surfaceCoats" type="number" placeholder="Coats" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="surfaceQuantity" type="number" step="0.1" placeholder="Litres bought" /></div>
                            <div class="col-md-4"><input class="form-control" @bind="surfacePaintedDate" type="date" title="Date painted" /></div>
                        </div>
                        <input class="form-control mb-2" @bind="surfacePainter" placeholder="Painter" />
                    }
                }
                <div class="row g-2 mb-2">
                    <div class="col-md-3"><input class="form-control" @bind="surfaceSortOrder" type="number" title="Sort order" placeholder="Order" /></div>
                    <div class="col-md-9"><input class="form-control" @bind="surfaceNotes" placeholder="Notes" /></div>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="SaveSurface">@(editingSurfaceId is null ? "Add surface" : "Update surface")</button>
                    @if (editingSurfaceId is not null) { <button class="btn btn-outline-secondary ms-2" @onclick="ClearSurfaceForm">Cancel</button> }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <h3 class="h5">Surfaces</h3>
            @if (surfaces.Count == 0)
            {
                <div class="alert alert-info">No surfaces yet.</div>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var surface in surfaces.OrderBy(s => s.SortOrder).ThenBy(s => s.Name))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@surface.Name</strong> <span class="badge text-bg-light">@surface.SurfaceType</span>
                                <div class="small text-muted">@SurfaceSummary(surface)</div>
                                @if (!string.IsNullOrEmpty(surface.Notes)) { <div class="small text-muted">@surface.Notes</div> }
                            </div>
                            <div class="text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEditSurface(surface)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSurface(surface.Id)">Delete</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="card card-body mt-4">
        <h3 class="h5">Room photos</h3>
        <PhotoManager Endpoint="@($"api/rooms/{selectedRoomId}/photos")" />
    </div>
}

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    List<PropertyDto> properties = [];
    List<FloorDto> floors = [];
    List<RoomDto> rooms = [];
    List<SurfaceDto> surfaces = [];

    string floorId = "", roomName = "", roomType = "", roomArea = "", roomVolume = "", roomCeilingHeight = "", roomLength = "", roomWidth = "", roomHeight = "";
    string roomFlooring = "", roomWallFinish = "", roomCeilingFinish = "", roomPaintDetails = "", roomWindowsCount = "", roomDoorsCount = "";
    string roomFixturesNotes = "", roomUtilitiesNotes = "", roomNotes = "";
    static readonly string[] SurfaceTypes = ["wall", "ceiling", "flooring", "trim"];
    string selectedRoomId = "", surfaceName = "", surfaceType = "wall", surfaceSortOrder = "0", surfaceNotes = "";
    string surfacePaintBrand = "", surfaceColorName = "", surfaceColorCode = "", surfaceFinish = "", surfaceCoats = "", surfacePainter = "", surfaceQuantity = "";
    DateOnly? surfacePaintedDate, surfaceInstallationDate;
    string surfaceManufacturer = "", surfaceProductName = "", surfaceMaterial = "", surfaceSupplier = "", surfaceWarranty = "", surfaceInvoice = "";
    Guid? editingSurfaceId;
    
    Guid? editingRoomId;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        properties = await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties") ?? [];
        floors = await Http.GetFromJsonAsync<List<FloorDto>>("api/floors") ?? [];
        rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? [];
        surfaces = [];
    }

    void StartEdit(RoomDto room)
    {
        editingRoomId = room.Id;
        floorId = room.FloorId.ToString();
        roomName = room.Name;
        roomType = room.Type ?? "";
        roomArea = room.Area?.ToString() ?? "";
        roomVolume = room.Volume?.ToString() ?? "";
        roomCeilingHeight = room.CeilingHeight?.ToString() ?? "";
        roomLength = room.Length?.ToString() ?? "";
        roomWidth = room.Width?.ToString() ?? "";
        roomHeight = room.Height?.ToString() ?? "";
        roomFlooring = room.Flooring ?? "";
        roomWallFinish = room.WallFinish ?? "";
        roomCeilingFinish = room.CeilingFinish ?? "";
        roomPaintDetails = room.PaintDetails ?? "";
        roomWindowsCount = room.WindowsCount?.ToString() ?? "";
        roomDoorsCount = room.DoorsCount?.ToString() ?? "";
        roomFixturesNotes = room.FixturesNotes ?? "";
        roomUtilitiesNotes = room.UtilitiesNotes ?? "";
        roomNotes = room.Notes ?? "";
    }

    void CancelEdit()
    {
        editingRoomId = null;
        ClearForm();
    }

    void ClearForm()
    {
        floorId = roomName = roomType = roomArea = roomVolume = roomCeilingHeight = roomLength = roomWidth = roomHeight = "";
        roomFlooring = roomWallFinish = roomCeilingFinish = roomPaintDetails = roomWindowsCount = roomDoorsCount = "";
        roomFixturesNotes = roomUtilitiesNotes = roomNotes = "";
    }

    async Task SaveRoom()
    {
        error = null;
        if (!Guid.TryParse(floorId, out var parsedFloorId)) { error = "Choose a floor first."; return; }
        if (string.IsNullOrWhiteSpace(roomName)) { error = "Room name is required."; return; }

        var response = editingRoomId is null
            ? await Http.PostAsJsonAsync("api/rooms", new RoomInput(parsedFloorId, roomName, roomType, TryDecimal(roomArea), TryDecimal(roomVolume), TryDecimal(roomCeilingHeight), TryDecimal(roomLength), TryDecimal(roomWidth), TryDecimal(roomHeight), roomFlooring, roomWallFinish, roomCeilingFinish, roomPaintDetails, TryInt(roomWindowsCount), TryInt(roomDoorsCount), roomFixturesNotes, roomUtilitiesNotes, roomNotes))
            : await Http.PutAsJsonAsync($"api/rooms/{editingRoomId}", new RoomInput(parsedFloorId, roomName, roomType, TryDecimal(roomArea), TryDecimal(roomVolume), TryDecimal(roomCeilingHeight), TryDecimal(roomLength), TryDecimal(roomWidth), TryDecimal(roomHeight), roomFlooring, roomWallFinish, roomCeilingFinish, roomPaintDetails, TryInt(roomWindowsCount), TryInt(roomDoorsCount), roomFixturesNotes, roomUtilitiesNotes, roomNotes));

        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        editingRoomId = null;
        ClearForm();
        rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? [];
    }

    async Task DeleteRoom(Guid roomId)
    {
        error = null;
        var response = await Http.DeleteAsync($"api/rooms/{roomId}");
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        rooms = await Http.GetFromJsonAsync<List<RoomDto>>("api/rooms") ?? [];
    }

    async Task LoadRoomDetails()
    {
        surfaces = [];
        ClearSurfaceForm();
        if (!Guid.TryParse(selectedRoomId, out var roomId)) return;
        surfaces = await Http.GetFromJsonAsync<List<SurfaceDto>>($"api/rooms/{roomId}/surfaces") ?? [];
    }

    void StartEditSurface(SurfaceDto surface)
    {
        editingSurfaceId = surface.Id;
        surfaceName = surface.Name;
        surfaceType = SurfaceTypes.Contains(surface.SurfaceType) ? surface.SurfaceType : "wall";
        surfacePaintBrand = surface.PaintBrand ?? "";
        surfaceColorName = surface.ColorName ?? "";
        surfaceColorCode = surface.ColorCode ?? "";
        surfaceFinish = surface.Finish ?? "";
        surfaceCoats = surface.Coats?.ToString() ?? "";
        surfacePaintedDate = surface.PaintedDate;
        surfacePainter = surface.Painter ?? "";
        surfaceQuantity = surface.QuantityPurchased?.ToString() ?? "";
        surfaceManufacturer = surface.Manufacturer ?? "";
        surfaceProductName = surface.ProductName ?? "";
        surfaceMaterial = surface.Material ?? "";
        surfaceSupplier = surface.Supplier ?? "";
        surfaceWarranty = surface.Warranty ?? "";
        surfaceInvoice = surface.Invoice ?? "";
        surfaceInstallationDate = surface.InstallationDate;
        surfaceNotes = surface.Notes ?? "";
        surfaceSortOrder = surface.SortOrder.ToString();
    }

    void ClearSurfaceForm()
    {
        editingSurfaceId = null;
        surfaceType = "wall";
        surfaceName = surfacePaintBrand = surfaceColorName = surfaceColorCode = surfaceFinish = surfaceCoats = surfacePainter = surfaceQuantity = "";
        surfacePaintedDate = surfaceInstallationDate = null;
        surfaceManufacturer = surfaceProductName = surfaceMaterial = surfaceSupplier = surfaceWarranty = surfaceInvoice = surfaceNotes = "";
        surfaceSortOrder = "0";
    }

    async Task SaveSurface()
    {
        error = null;
        if (!Guid.TryParse(selectedRoomId, out var roomId)) { error = "Choose a room first."; return; }
        if (string.IsNullOrWhiteSpace(surfaceName)) { error = "Surface name is required."; return; }
        // Only send the fields that belong to the selected type so switching type doesn't leave stale values behind.
        var flooring = surfaceType == "flooring";
        var paintedArea = surfaceType is "wall" or "ceiling";
        var input = new SurfaceInput(roomId, surfaceName, surfaceType,
            flooring ? null : surfacePaintBrand, surfaceColorName, flooring ? null : surfaceColorCode, flooring ? null : surfaceFinish,
            paintedArea ? TryInt(surfaceCoats) : null, paintedArea ? surfacePaintedDate : null,
            paintedArea ? surfacePainter : null, paintedArea ? TryDecimal(surfaceQuantity) : null,
            flooring ? surfaceManufacturer : null, flooring ? surfaceProductName : null, flooring ? surfaceMaterial : null, flooring ? surfaceSupplier : null,
            flooring ? surfaceWarranty : null, flooring ? surfaceInvoice : null, flooring ? surfaceInstallationDate : null,
            surfaceNotes, TryInt(surfaceSortOrder) ?? 0);
        var response = editingSurfaceId is null
            ? await Http.PostAsJsonAsync($"api/rooms/{roomId}/surfaces", input)
            : await Http.PutAsJsonAsync($"api/surfaces/{editingSurfaceId}", input);
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        ClearSurfaceForm();
        surfaces = await Http.GetFromJsonAsync<List<SurfaceDto>>($"api/rooms/{roomId}/surfaces") ?? [];
    }

    async Task DeleteSurface(Guid surfaceId)
    {
        error = null;
        var response = await Http.DeleteAsync($"api/surfaces/{surfaceId}");
        if (!response.IsSuccessStatusCode) { error = await response.Content.ReadAsStringAsync(); return; }
        if (editingSurfaceId == surfaceId) ClearSurfaceForm();
        surfaces = await Http.GetFromJsonAsync<List<SurfaceDto>>($"api/rooms/{selectedRoomId}/surfaces") ?? [];
    }

    string RoomLabel(RoomDto room)
    {
        var floor = floors.FirstOrDefault(f => f.Id == room.FloorId);
        var property = floor is null ? null : properties.FirstOrDefault(p => p.Id == floor.PropertyId);
        return floor is null ? room.Name : $"{property?.Name} · {floor.Name} · {room.Name}";
    }

    static string SurfaceSummary(SurfaceDto s) => string.Join(" · ", new[]
    {
        s.SurfaceType == "flooring" ? s.Material : s.PaintBrand,
        s.SurfaceType == "flooring" ? s.ProductName : null,
        string.Join(" ", new[] { s.ColorName, s.ColorCode is null ? null : $"({s.ColorCode})" }.Where(x => !string.IsNullOrWhiteSpace(x))),
        s.Finish,
        s.Coats is null ? null : $"{s.Coats} coats",
        s.PaintedDate is null ? null : $"painted {s.PaintedDate:yyyy-MM-dd}",
        s.InstallationDate is null ? null : $"installed {s.InstallationDate:yyyy-MM-dd}",
        s.Supplier,
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    static string FormatNumber(decimal? number) => number?.ToString("0.00") ?? "-";
    static DateOnly? TryDateOnly(string? value) => DateOnly.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var result) ? result : null;
    static decimal? TryDecimal(string? value) => decimal.TryParse(value, out var result) ? result : null;
    static int? TryInt(string? value) => int.TryParse(value, out var result) ? result : null;
}
