@if (PathSegments is not null && PathSegments.Count > 0)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">Home</a>
            </li>
            @foreach (var (label, url, index) in PathSegments.Select((x, i) => (x.Label, x.Url, i)))
            {
                @if (index == PathSegments.Count - 1)
                {
                    <li class="breadcrumb-item active" aria-current="page">@label</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="@url">@label</a>
                    </li>
                }
            }
        </ol>
    </nav>
}

@code {
    [Parameter]
    public List<BreadcrumbItem>? PathSegments { get; set; } = new();

    public class BreadcrumbItem
    {
        public string Label { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }
}
