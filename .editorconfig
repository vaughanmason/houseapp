root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# Entity names such as Property and Document are part of the database schema and API; the clash is only with Visual Basic keywords.
dotnet_diagnostic.CA1716.severity = none

[HomeInventory/Migrations/*.cs]
# Generated by dotnet-ef.
generated_code = true

[HomeInventory.Tests/**.cs]
# xUnit test names use underscores (Method_Scenario_Result).
dotnet_diagnostic.CA1707.severity = none
